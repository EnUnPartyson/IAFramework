# Datasets (nunca a git, son pesados y se regeneran con download_dataset.py)
data/raw/
data/processed/

# Pesos de modelos: los 6 finales SI se versionan (commit directo, ~124MB una sola vez)
# porque el equipo necesita compartirlos y no habra mas reentrenamientos. Todo lo demas
# (checkpoints intermedios, pesos sueltos fuera de models/) sigue fuera del repo.
*.pt
*.pth
*.h5
*.keras
!models/*.pt
!models/*.keras
checkpoints/

# Entornos virtuales
venv/
venv-torch/
venv-tf/
.venv/
__pycache__/
*.pyc

# Configuración local / credenciales
.env
*.pem

# OS / editor
.DS_Store
.vscode/settings.json

# App Ionic (se regeneran con npm install / npm run build)
app/node_modules/
app/dist/
app/.angular/
app/android/
app/ios/

# app-onnx (Mascotas Live): mismos criterios; public/models SI se versiona (la app no
# compila sin los .onnx) y public/ort NO (se regenera con npm run copy-ort)
app-onnx/node_modules/
app-onnx/dist/
app-onnx/android/
app-onnx/public/ort/

# exportes ONNX intermedios (reproducibles con inference/export_onnx.py; las copias que
# importan viven en app-onnx/public/models/)
models/onnx/

# Capturas del script de camara
capturas/

# Logs
*.log
