# Datasets (nunca a git, son pesados y se regeneran con download_dataset.py)
data/raw/
data/processed/

# Pesos de modelos: los 6 finales SI se versionan, via Git LFS (ver .gitattributes),
# porque el equipo necesita compartirlos. Todo lo demas (checkpoints intermedios, pesos
# sueltos fuera de models/) sigue fuera del repo.
*.pt
*.pth
*.h5
*.keras
!models/*.pt
!models/*.keras
checkpoints/

# Entornos virtuales
venv/
venv-torch/
venv-tf/
.venv/
__pycache__/
*.pyc

# Configuración local / credenciales
.env
*.pem

# OS / editor
.DS_Store
.vscode/settings.json

# App Ionic (se regeneran con npm install / npm run build)
app/node_modules/
app/dist/
app/.angular/
app/android/
app/ios/

# Capturas del script de camara
capturas/

# Logs
*.log
