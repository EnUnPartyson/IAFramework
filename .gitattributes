# run_all.sh se ejecuta en EC2 Linux: forzar LF aunque el repo se edite en Windows
*.sh text eol=lf

# Pesos de modelos por Git LFS: pesan ~124MB en total y el repo no debe cargarlos en
# su historial. Quien clone necesita git-lfs instalado ('git lfs install' una vez).
models/*.pt filter=lfs diff=lfs merge=lfs -text
models/*.keras filter=lfs diff=lfs merge=lfs -text
